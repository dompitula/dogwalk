{
  "name": "the-good-walk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "create-env": "node scripts/create-env.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "4.0.0-beta.6",
    "@payloadcms/next": "4.0.0-beta.6",
    "@payloadcms/richtext-lexical": "4.0.0-beta.6",
    "@payloadcms/translations": "4.0.0-beta.6",
    "@payloadcms/ui": "4.0.0-beta.6",
    "graphql": "^16.8.1",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "payload": "4.0.0-beta.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "cross-env": "^7.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
