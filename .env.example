# Environment settings for local development.
# Create `.env` from this file with:  pnpm run create-env
# (or copy it to `.env` by hand and fill in PAYLOAD_SECRET yourself).

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Local SQLite database file (created automatically on first start).
DATABASE_URL=file:./shelter.db

# Public URL of the site, used for page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sample data (a shelter, 3 dogs, walks and demo bookings) is added to an empty
# database when the app first starts. Uncomment to start with an empty database
# instead; `deploy.sh --clean` does the same.
# SAMPLE_DATA=false

# Booking emails are configured in the staff panel at /dashboard/email.
# No RESEND_API_KEY or EMAIL_FROM environment variables are required.
# Keep PAYLOAD_SECRET stable: it also protects the saved email credentials.
