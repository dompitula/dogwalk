# Environment settings for local development.
# Create `.env` from this file with:  pnpm run create-env
# (or copy it to `.env` by hand and fill in PAYLOAD_SECRET yourself).

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Local SQLite database file (created automatically on first start).
DATABASE_URL=file:./shelter.db

# Public URL of the site, used for page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
