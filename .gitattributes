# Text files are checked out with LF line endings on every system, as the
# formatter (oxfmt) writes them. With Git's default on Windows (CRLF),
# `pnpm format:check` would report every file.
* text=auto eol=lf
# Shell scripts must keep LF line endings: with CRLF, bash fails with
# "$'\r': command not found".
*.sh text eol=lf
# Batch files need CRLF line endings to be parsed reliably by cmd.exe.
*.cmd text eol=crlf
